{
  "manifest_version": 3,
  "name": "LectioPlus+",
  "version": "0.1.10",
  "description": "En ny brugerflade til Lectio med ugeplan, opgaveliste, lektier og beskeder.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "LectioPlus+",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "strafe-clicker-icon.png",
        "icon-32.png",
        "punctuation-frame.html",
        "workbench-host.html",
        "workbench-sandbox.html"
      ],
      "matches": [
        "https://lectio.dk/*",
        "https://www.lectio.dk/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lectio.dk/*",
        "https://www.lectio.dk/*"
      ],
      "js": [
        "appearance.js",
        "boot.js",
        "privacy.js"
      ],
      "css": [
        "theme.css",
        "styles.css",
        "workspace.css",
        "native.css",
        "native-pages.css",
        "customization.css",
        "school-tools.css",
        "school-picker.css",
        "school-lab.css",
        "privacy.css",
        "vendor/workbench/codemirror/lib/codemirror.css",
        "school-expanded.css",
        "school-polish.css",
        "games.css",
        "party.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lectio.dk/*",
        "https://www.lectio.dk/*"
      ],
      "include_globs": [
        "https://*/",
        "https://*/?*",
        "https://*/lectio/login_list.aspx*"
      ],
      "js": [
        "tab-branding.js",
        "school-picker.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://lectio.dk/lectio/*",
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "native-theme.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://lectio.dk/lectio/*",
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "icons.js",
        "hints.js",
        "lectio-data.js",
        "workspace.js",
        "native-layout.js",
        "tab-branding.js",
        "settings-transfer.js",
        "settings-extras.js",
        "custom-sidebar.js",
        "settings.js",
        "school-math.js",
        "school-elements.js",
        "school-chemistry.js",
        "school-lab-core.js",
        "punctuation-client.js",
        "school-writing.js",
        "translation.js",
        "school-expanded-core.js",
        "school-expanded-science.js",
        "school-expanded-data.js",
        "school-code-lessons.js",
        "school-catalog.js",
        "school-language.js",
        "school-visuals.js",
        "school-molecule-builder.js",
        "school-lab.js",
        "vendor/workbench/codemirror/lib/codemirror.js",
        "vendor/workbench/codemirror/mode/python/python.js",
        "vendor/workbench/codemirror/mode/javascript/javascript.js",
        "vendor/workbench/codemirror/mode/xml/xml.js",
        "vendor/workbench/codemirror/mode/css/css.js",
        "vendor/workbench/codemirror/mode/htmlmixed/htmlmixed.js",
        "vendor/workbench/codemirror/mode/sql/sql.js",
        "workbench-client.js",
        "school-expanded-ui.js",
        "school-science-workshop.js",
        "school-diagram-workshop.js",
        "school-study-workshop.js",
        "school-code-layout.js",
        "school-code-workshop.js",
        "school-special.js",
        "school-tools.js",
        "rhythm.js",
        "dash.js",
        "games-core.js",
        "games.js",
        "party.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "translation-worker.js"
  },
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'sha256-7wYrTDpp/fNS5tj1ln++4StcBsO9kpRRU3VKSBnw1Pk=' 'unsafe-eval' blob:; worker-src blob:; connect-src blob:; child-src 'none';"
  },
  "sandbox": {
    "pages": [
      "workbench-sandbox.html"
    ]
  }
}
