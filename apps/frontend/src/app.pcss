@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300..800&display=swap');
@tailwind base;
@tailwind components;
@tailwind utilities;

/*
 * Design tokens ported from the LectioPlus+ extension.
 * Values are HSL triplets so Tailwind's `hsl(var(--x) / <alpha-value>)` works.
 * The colour design (data-design on <html>) only sets the --design-* values;
 * light/dark (the `dark` class set by mode-watcher) decides which of them are used.
 */
@layer base {
  :root,
  :root[data-design='indigo'] {
    --design-accent-light: 240.5 45.7% 49.8%;
    --design-accent-dark: 239 100% 87.8%;
    --design-tint-light: 236.5 100% 96.7%;
    --design-tint-dark: 234.4 29.7% 28.4%;
    --design-mark: 241 56.1% 58%;
  }
  :root[data-design='ocean'] {
    --design-accent-light: 200.3 87.6% 28.4%;
    --design-accent-dark: 197.4 90.9% 78.4%;
    --design-tint-light: 204.4 100% 94.7%;
    --design-tint-dark: 204.2 48.1% 21.2%;
    --design-mark: 197.5 81.9% 36.9%;
  }
  :root[data-design='forest'] {
    --design-accent-light: 154.6 45% 25.7%;
    --design-accent-dark: 146.9 54.5% 75.9%;
    --design-tint-light: 137.1 41.2% 93.3%;
    --design-tint-dark: 160 29.4% 20%;
    --design-mark: 149.6 43% 35.1%;
  }
  :root[data-design='teal'] {
    --design-accent-light: 177.9 79.8% 21.4%;
    --design-accent-dark: 172.3 65% 76.5%;
    --design-tint-light: 174.3 53.8% 92.4%;
    --design-tint-dark: 188.8 39.8% 20.2%;
    --design-mark: 177.2 72% 29.4%;
  }
  :root[data-design='slate'] {
    --design-accent-light: 211.2 28.9% 32.5%;
    --design-accent-dark: 213.5 53.1% 84.1%;
    --design-tint-light: 210 43.8% 93.7%;
    --design-tint-dark: 217.1 26.2% 25.5%;
    --design-mark: 211.3 22.6% 41.6%;
  }
  :root[data-design='lavender'] {
    --design-accent-light: 263.4 41.9% 44.5%;
    --design-accent-dark: 265.3 100% 88.8%;
    --design-tint-light: 265.7 100% 95.9%;
    --design-tint-dark: 261.5 27.3% 28%;
    --design-mark: 265.4 44.4% 54.1%;
  }
  :root[data-design='raspberry'] {
    --design-accent-light: 327 48.7% 36.7%;
    --design-accent-dark: 329.5 100% 87.6%;
    --design-tint-light: 325.3 76% 95.1%;
    --design-tint-dark: 307.7 25.6% 23.7%;
    --design-mark: 328.3 43.2% 49%;
  }
  :root[data-design='ruby'] {
    --design-accent-light: 344.9 52.3% 38.6%;
    --design-accent-dark: 351.2 100% 86.7%;
    --design-tint-light: 350.5 76% 95.1%;
    --design-tint-dark: 332 25% 23.5%;
    --design-mark: 349.2 46.2% 49.6%;
  }
  :root[data-design='coral'] {
    --design-accent-light: 14.4 55.9% 36.5%;
    --design-accent-dark: 19.5 100% 83.1%;
    --design-tint-light: 20.9 100% 95.5%;
    --design-tint-dark: 12.9 23% 23.9%;
    --design-mark: 15.5 52.9% 47.5%;
  }
  :root[data-design='amber'] {
    --design-accent-light: 39.8 84.3% 24.9%;
    --design-accent-dark: 39.6 90.1% 76.3%;
    --design-tint-light: 41.1 100% 92.5%;
    --design-tint-dark: 35.2 25.2% 22.5%;
    --design-mark: 42.3 69.3% 34.5%;
  }

  :root {
    --background: 222.9 41.2% 96.7%;
    --foreground: 222 37.5% 15.7%;
    --card: 0 0% 100%;
    --card-foreground: 222 37.5% 15.7%;
    --popover: 0 0% 100%;
    --popover-foreground: 222 37.5% 15.7%;
    --primary: var(--design-accent-light);
    --primary-foreground: 0 0% 100%;
    --secondary: 222.9 53.8% 97.5%;
    --secondary-foreground: 222 37.5% 15.7%;
    --muted: 222.9 53.8% 97.5%;
    --muted-foreground: 218.5 19.2% 39.8%;
    --accent: var(--design-tint-light);
    --accent-foreground: var(--design-accent-light);
    --destructive: 346.2 59.4% 38.6%;
    --destructive-foreground: 0 0% 100%;
    --border: 217.5 33.3% 90.6%;
    --input: 217.5 33.3% 90.6%;
    --ring: var(--design-mark);
    --radius: 0.5rem;
    --shadow: 0 2px 7px #17294a0b;

    --tooltip: 220.6 35.6% 17.1%;
    --tooltip-foreground: 231.4 100% 98.6%;

    --tone-blue: 210.2 65.4% 36.3%;
    --tone-blue-bg: 211.3 100% 95.5%;
    --tone-amber: 36.2 87.4% 24.9%;
    --tone-amber-bg: 36.9 100% 92.4%;
    --tone-green: 158.6 53.8% 25.5%;
    --tone-green-bg: 153 50% 92.2%;
    --tone-red: 346.2 59.4% 38.6%;
    --tone-red-bg: 348 83.3% 95.3%;
    --tone-teal: 183.7 69.5% 23.1%;
    --tone-teal-bg: 176.8 46.3% 92%;
    --tone-plum: 282.9 39.9% 37.8%;
    --tone-plum-bg: 280 69.2% 94.9%;
  }
  .dark {
    --background: 227.4 33.3% 11.2%;
    --foreground: 230.8 61.9% 95.9%;
    --card: 225 29.3% 16.1%;
    --card-foreground: 230.8 61.9% 95.9%;
    --popover: 225 29.3% 16.1%;
    --popover-foreground: 230.8 61.9% 95.9%;
    --primary: var(--design-accent-dark);
    --primary-foreground: 227.4 33.3% 11.2%;
    --secondary: 223.4 28.2% 20.2%;
    --secondary-foreground: 230.8 61.9% 95.9%;
    --muted: 223.4 28.2% 20.2%;
    --muted-foreground: 220.6 28.3% 76.5%;
    --accent: var(--design-tint-dark);
    --accent-foreground: var(--design-accent-dark);
    --destructive: 347.2 100% 85.3%;
    --destructive-foreground: 227.4 33.3% 11.2%;
    --border: 222.6 21.1% 28.8%;
    --input: 222.6 21.1% 28.8%;
    --ring: var(--design-accent-dark);
    --shadow: none;

    --tooltip: 228.8 100% 96.9%;
    --tooltip-foreground: 222 37.5% 15.7%;

    --tone-blue: 209.6 100% 83.3%;
    --tone-blue-bg: 213.5 36.1% 23.3%;
    --tone-amber: 38 87.5% 78%;
    --tone-amber-bg: 32.9 31.3% 19.4%;
    --tone-green: 158.4 49.6% 75.9%;
    --tone-green-bg: 166.2 26.5% 19.2%;
    --tone-red: 347.2 100% 85.3%;
    --tone-red-bg: 333.1 25.2% 22.5%;
    --tone-teal: 177.4 60.3% 77.3%;
    --tone-teal-bg: 190.8 37.9% 20.2%;
    --tone-plum: 279.3 87.3% 87.6%;
    --tone-plum-bg: 280 23.4% 25.1%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground;
  }
  :focus-visible {
    outline-color: hsl(var(--ring));
  }
}

.page-container {
  @apply container mx-auto p-4 xl:p-10 space-y-10;
}

.page-container-x {
  @apply container mx-auto px-4 xl:px-10;
}

/* Kompakt density from LectioPlus+ */
:root[data-density='compact'] .page-container {
  @apply p-3 xl:p-6 space-y-6;
}

:root[data-density='compact'] .page-container-x {
  @apply px-3 xl:px-6;
}

h1:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply text-4xl leading-[1.11] font-bold;
}

h2:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply text-2xl leading-[1.33] font-bold mt-[2em];
}
h3:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply text-xl leading-[1.6] font-semibold mb-2 mt-6;
}

h2 + *:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply !mt-0;
}
h3 + *:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply !mt-0;
}

ul:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply list-disc pl-6;
}

a:not(:where([class~='unstyled'], [class~='unstyled'] *)) {
  @apply underline font-medium;
}

::-webkit-scrollbar {
  display: none;
}

.fc-timegrid-event .fc-event-main {
  @apply p-0.5;
}

.fc-timegrid-event-harness-inset .fc-timegrid-event,
.fc-timegrid-event.fc-event-mirror,
.fc-timegrid-more-link {
  @apply shadow-none rounded-md;
}

.fc-event {
  @apply border overflow-hidden border-input bg-background shadow-sm hover:bg-accent ring-0 hover:text-accent-foreground inline-flex whitespace-nowrap rounded-md transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50;
}

.event-cancelled {
  @apply border-2 !border-tone-red;
}

:is(.event-cancelled .fc-event-title) {
  text-decoration: line-through;
}

.fc-event-title {
  @apply font-medium text-sm dark:font-semibold;
}

:is(.event-cancelled .fc-event-title) {
  @apply text-tone-red;
}

:is(.event-cancelled .fc-event-time) {
  @apply text-tone-red;
}

.fc .fc-button {
  @apply border border-input bg-background text-primary shadow-sm hover:bg-accent ring-0 hover:text-accent-foreground inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50;
}

.fc .fc-button-primary:disabled {
  @apply border border-input bg-background text-primary shadow-sm hover:bg-accent ring-0 hover:text-accent-foreground inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50;
}

.fc .fc-button-primary {
  @apply border-input hover:border-input;
}

.fc .fc-button-primary:disabled {
  @apply border-input hover:border-input;
}

.fc .fc-timegrid-col.fc-day-today {
  background-color: transparent;
}

.fc .fc-timegrid-now-indicator-arrow {
  border-width: 5px 0px 5px 6px !important;
  border-bottom-color: transparent !important;
  border-top-color: transparent !important;
  @apply border-primary;
}

.fc .fc-timegrid-now-indicator-line {
  @apply mt-[-2px] border-[2px] border-primary;
}

.fc .fc-scrollgrid {
  @apply bg-background rounded-lg;
}

.fc .fc-timegrid-slot-label {
  @apply block border-none !mt-[-1em];
}

.fc tr:first-child .fc-timegrid-slot-label {
  @apply hidden;
}

.fc-theme-standard .fc-scrollgrid {
  @apply dark:border-input;
}
.fc-theme-standard td {
  @apply dark:border-input;
}
.fc-theme-standard th {
  @apply dark:border-input;
}

.apexcharts-svg {
  @apply dark:!bg-primary;
}

[data-tippy-root] {
  max-width: calc(100vw - 10px);
}

.tippy-box {
  position: relative;
  @apply z-50 w-64 rounded-md border bg-popover p-2 text-popover-foreground outline-none;
  box-shadow: var(--shadow);
  font-size: 14px;
  line-height: 1.4;
  white-space: normal;
  outline: 0;
  transition-property: all;
}

.tippy-box[data-placement^='top'] > .tippy-arrow {
  bottom: 0;
}

.tippy-box[data-placement^='top'] > .tippy-arrow:before {
  bottom: -7px;
  left: 0;
  border-width: 8px 8px 0;
  border-top-color: hsl(var(--popover));
  transform-origin: center top;
}

.tippy-arrow {
  width: 16px;
  height: 16px;
}

.tippy-arrow:before {
  content: '';
  position: absolute;
  border-color: transparent;
  border-style: solid;
}

.tippy-content {
  position: relative;
  padding: 5px 9px;
  z-index: 1;
}
